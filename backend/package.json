{
  "name": "bloodconnect-backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "nodemon --delay 500 --watch . --ignore node_modules/ --ignore public/ --ignore __tests__/ --ignore '*.test.js' --ignore '.jest-*' server.js",
    "start": "NODE_ENV=production node server.js",
    "test": "node --experimental-vm-modules node_modules/.bin/jest --runInBand --no-coverage --verbose",
    "test:watch": "node --experimental-vm-modules node_modules/.bin/jest --runInBand --watch --verbose",
    "test:unit": "node --experimental-vm-modules node_modules/.bin/jest --runInBand --no-coverage --verbose __tests__/unit",
    "test:integration": "node --experimental-vm-modules node_modules/.bin/jest --runInBand --no-coverage --verbose --forceExit __tests__/integration"
  },
  "jest": {
    "transform": {},
    "testEnvironment": "node",
    "testRunner": "jest-circus/runner",
    "testTimeout": 60000,
    "roots": [
      "<rootDir>/__tests__"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/"
    ]
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "google-auth-library": "^10.6.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.0",
    "multer": "^2.0.2",
    "nodemailer": "^6.9.13"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "jest-circus": "^29.7.0",
    "mongodb-memory-server": "^11.1.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.2.2"
  }
}
